# The image is built from source, so the context carries the app but none of
# the local state, tooling output or test scaffolding.

.git
.github
node_modules
.next
.next.tar.gz
out
coverage
test-results
playwright-report
blob-report

# Tests and their tooling run in CI, never inside the image build.
tests
playwright.config.mjs
vitest.config.mjs

# Local environment and editor state.
.env
.env.*
.vscode
.idea
.claude
*.swp
.DS_Store

# Docs
*.md
guia*.txt
LICENSE
