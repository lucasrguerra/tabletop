{
  "name": "tabletop",
  "author": "Lucas Rayan Guerra",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "build:release": "next build && tar --dereference -czf .next.tar.gz .next/standalone .next/static",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "clean": "npx -y rimraf .next .next.tar.gz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:theme": "next build && playwright test theme.spec.mjs",
    "test:all": "vitest run && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "mongoose": "^9.9.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.25",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "mongodb-memory-server": "^10.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "mongodbMemoryServer": {
    "version": "9.0.1"
  }
}
